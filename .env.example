# Stargate Wars runtime configuration
SGW_TITLE=Pegus Galaxy
SGW_SUBTITLE=The place to get your war on!
SGW_ADMIN_EMAIL=admin@example.com
# Local development only; keep disabled in production.
SGW_BYPASS_LOGIN=0

# Database connection
SGW_DB_HOST=localhost
SGW_DB_NAME=sgw
SGW_DB_USER=sgw
SGW_DB_PASS=sgwpass

# Email transport: use smtp only after configuring a verified provider.
GAME_MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=root@universecivilization.game
SMTP_ENCRYPTION=tls
SMTP_TIMEOUT=15

# Root administrator provisioning; set only at deployment time.
SGW_ROOT_USERNAME=root
SGW_ROOT_EMAIL=root@universecivilization.game
SGW_ROOT_PASSWORD=replace-with-unique-16-character-password
